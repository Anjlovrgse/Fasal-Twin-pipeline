# Copy this file to .env.local for local development.

# MapTiler — get a free key at https://cloud.maptiler.com/
# Paste your key here; the map uses a free offline fallback style when this is absent
# or unreachable.
VITE_MAPTILER_KEY=YOUR_MAPTILER_KEY_HERE

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000
