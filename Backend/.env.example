# Fasal Twin Backend Environment Configuration
# Copy this file to .env for local runtime execution

# Allowed CORS origins for frontend web interfaces (comma-separated list)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://fasal-twin.onrender.com

# Live Weather Provider Configuration:
# Options: 'open_meteo' (recommended: zero key required, open public API) or 'openweathermap'
WEATHER_PROVIDER=open_meteo
WEATHER_API_KEY=your_weather_api_key_here
LIVE_WEATHER_ENABLED=true
LIVE_WEATHER_TIMEOUT_SECONDS=2.5

# Data.gov.in Open Government Data API Key (Agmarknet Live Mandi Resource)
DATA_GOV_IN_API_KEY=579b464db66ec23bdd000001775ae41dd96a4d1978f9920f86bda0a2

# Optional Gemini API Key for LLM functionality
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port and Host Configuration
PORT=8000
HOST=0.0.0.0

# Logging Level
LOG_LEVEL=info
